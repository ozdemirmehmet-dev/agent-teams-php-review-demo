# Copy to .env and fill in. Never commit .env.
# The app reads these with getenv(); see README.md for how to load them.

# Database (required)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app_db
DB_USER=app_login
DB_PASS=change-me

# 1 (default) = Secure cookies, __Host- prefix and HSTS. Set to 0 only for local HTTP development.
HTTPS_ONLY=1

# Comma-separated IPs of your own reverse proxies / load balancers. Leave empty if there are none.
TRUSTED_PROXIES=
